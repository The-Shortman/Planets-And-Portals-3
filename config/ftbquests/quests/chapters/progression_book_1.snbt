	quests: [
		{
			description: [
				"Welcome! This is where your progression begins, same as a typical Minecraft playthrough. Punch a tree and get some logs."
				""
				"Do yourself a favour and craft that wood into some planks and sticks, get some wooden tools, and build a nice little starter house for yourself if you want."
			]
			icon: "minecraft:oak_log"
			id: "2BC7202742BC1535"
			shape: "octagon"
			size: 1.5d
			subtitle: "I refuse to do a TerraFirmaCraft style early game"
			tasks: [{
				id: "7063A8C16B28CD0C"
				item: {
					Count: 1
					id: "itemfilters:tag"
					tag: {
						value: "minecraft:logs"
					}
				}
				title: "Any #minecraft:logs"
				type: "item"
			}]
			title: "Punch any tree"
			x: -3.5d
			y: 0.0d
		}
		{
			dependencies: ["2BC7202742BC1535"]
			description: [
				"Don't worry! You aren't crazy!"
				""
				"Raw iron cannot be smelted as-is. You need to grind it up first before you can pack it into a furnace to get turned into a nicely baked iron ingot."
				""
				"Follow the questline to learn how to make a millstone."
			]
			id: "2D2CF91CDD25D91B"
			subtitle: "Help! I can't smelt this!"
			tasks: [{
				id: "4A1D7950BB674F48"
				item: "minecraft:raw_iron"
				type: "item"
			}]
			x: -0.5d
			y: -3.0d
		}
		{
			dependencies: ["2BC7202742BC1535"]
			description: ["Andesite alloy doesn't require iron in this modpack. Instead, get yourself some grout. This can be crafted with sand, gravel, and clay, so I'd recommend setting up by a river."]
			id: "49F88BFF272C28E9"
			subtitle: "Now without iron!"
			tasks: [{
				id: "3264B094B25F6548"
				item: "create:andesite_alloy"
